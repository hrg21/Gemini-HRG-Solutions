<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HRG Solutions | High-Impact Web Engineering</title>
<!-- CSS Dependencies -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">

<style>
body {
font-family: 'Inter', sans-serif;
background-color: #09090b;
color: white;
overflow-x: hidden;
}

.grid-bg {
background-image: radial-gradient(circle at center, #22d3ee 1px, transparent 1px);
background-size: 32px 32px;
opacity: 0.05;
}

.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

/* Smooth reveal for sections */
.reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s ease-out; }
.reveal.active { opacity: 1; transform: translateY(0); }

/* The horizontal container needs to be wide for GSAP to move it */
.scroll-container {
display: flex;
width: fit-content;
padding-left: 5vw;
padding-right: 5vw;
}

.project-card {
flex-shrink: 0;
width: 80vw;
max-width: 600px;
height: 450px;
margin-right: 4rem;
}

@media (max-width: 768px) {
.project-card { width: 85vw; height: 400px; margin-right: 2rem; }
}
</style>
</head>
<body class="selection:bg-cyan-500/30">

<!-- Grid Background -->
<div class="fixed inset-0 z-0 grid-bg pointer-events-none"></div>

<!-- Navigation -->
<nav class="fixed top-0 w-full z-[90] p-6 flex justify-between items-center bg-zinc-950/50 backdrop-blur-md border-b border-white/5">
<div class="flex items-center gap-3">
<div class="w-10 h-10 bg-gradient-to-tr from-cyan-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg">
<i data-lucide="rocket" class="w-6 h-6"></i>
</div>
<span class="font-black text-2xl tracking-tighter italic uppercase">HRG<span class="text-cyan-400">_SOLUTIONS</span></span>
</div>
<div class="hidden lg:flex items-center gap-2 bg-white/5 border border-white/10 p-1 rounded-full">
<a href="#stack" class="px-6 py-2 text-[10px] uppercase tracking-widest text-zinc-400 hover:text-white transition-all font-bold">Stack</a>
<a href="#history" class="px-6 py-2 text-[10px] uppercase tracking-widest text-zinc-400 hover:text-white transition-all font-bold">Work</a>
<a href="#services" class="px-6 py-2 text-[10px] uppercase tracking-widest text-zinc-400 hover:text-white transition-all font-bold">Services</a>
</div>
<button onclick="toggleModal(true)" class="bg-white text-black px-6 py-2 rounded-full text-[10px] font-black uppercase tracking-widest hover:bg-cyan-400 transition-all">Start Project</button>
</nav>

<!-- Hero -->
<section class="min-h-screen flex items-center justify-center pt-20 relative">
<div class="text-center px-6">
<div class="inline-flex items-center gap-3 bg-cyan-500/10 border border-cyan-500/20 px-4 py-2 rounded-full mb-8 reveal active">
<i data-lucide="radio" class="w-3 h-3 text-cyan-400 animate-pulse"></i>
<span class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest">Next-Gen Web Engineering</span>
</div>
<h1 class="text-[clamp(2.5rem,10vw,8rem)] font-black tracking-tighter leading-none uppercase mb-8 reveal active">
Engineering <br> High <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500 italic">Impact.</span>
</h1>
<p class="max-w-xl mx-auto text-zinc-400 text-lg md:text-xl mb-12 reveal active">
HRG Solutions builds lightning-fast websites optimized for SEO, speed, and conversion authority.
</p>
<button onclick="toggleModal(true)" class="bg-cyan-500 text-black px-12 py-6 rounded-full font-black uppercase tracking-widest text-xs hover:scale-105 transition-all shadow-xl shadow-cyan-500/20 reveal active">
Launch Project
</button>
</div>
</section>

<!-- Stack -->
<section id="stack" class="max-w-7xl mx-auto px-6 py-32">
<div class="reveal">
<span class="text-[10px] font-mono text-cyan-400 uppercase tracking-[0.5em] block mb-4">Philosophy_v1.0</span>
<h2 class="text-5xl md:text-7xl font-black uppercase tracking-tighter mb-16">The <span class="text-cyan-400 italic">Stack</span></h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
<div class="p-10 bg-zinc-900/40 border border-white/10 rounded-[2.5rem] reveal">
<i data-lucide="zap" class="text-cyan-400 mb-6 w-10 h-10"></i>
<h3 class="text-2xl font-bold mb-4">Edge Speed</h3>
<p class="text-zinc-500 text-sm">Server-side rendering for sub-second load times on any network.</p>
</div>
<div class="p-10 bg-zinc-900/40 border border-white/10 rounded-[2.5rem] reveal">
<i data-lucide="search" class="text-cyan-400 mb-6 w-10 h-10"></i>
<h3 class="text-2xl font-bold mb-4">SEO Dominance</h3>
<p class="text-zinc-500 text-sm">Technical structure designed to outrank competitors from day one.</p>
</div>
<div class="p-10 bg-zinc-900/40 border border-white/10 rounded-[2.5rem] reveal">
<i data-lucide="smartphone" class="text-cyan-400 mb-6 w-10 h-10"></i>
<h3 class="text-2xl font-bold mb-4">Adaptive UX</h3>
<p class="text-zinc-500 text-sm">Intelligent layouts that respond to user intent and device type.</p>
</div>
</div>
</section>

<!-- Work History (Pinned Scroll) -->
<section id="history" class="relative overflow-hidden">
<div class="max-w-7xl mx-auto px-6 mb-16">
<span class="text-[10px] font-mono text-cyan-400 uppercase tracking-[0.5em] block mb-4">Case_Studies</span>
<h2 class="text-5xl md:text-7xl font-black uppercase tracking-tighter">Work <span class="text-cyan-400 italic">History</span></h2>
</div>

<!-- The "Track" - This stays sticky while the child moves -->
<div class="horizontal-trigger h-[300vh] relative">
<div class="sticky top-0 h-screen flex items-center overflow-hidden">
<div class="scroll-container" id="horizontal-track">
<!-- Projects -->
<div class="project-card bg-zinc-900 border border-white/10 rounded-[3rem] p-8 md:p-12 flex flex-col justify-between">
<div>
<span class="text-cyan-400 font-bold text-xs uppercase tracking-widest">FinTech Platform</span>
<h3 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mt-4">Apex Capital</h3>
</div>
<div class="text-[10px] font-mono text-zinc-600 uppercase">Deployed // 2026</div>
</div>
<div class="project-card bg-zinc-900 border border-white/10 rounded-[3rem] p-8 md:p-12 flex flex-col justify-between">
<div>
<span class="text-cyan-400 font-bold text-xs uppercase tracking-widest">E-Commerce</span>
<h3 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mt-4">Velvet Store</h3>
</div>
<div class="text-[10px] font-mono text-zinc-600 uppercase">Deployed // 2026</div>
</div>
<div class="project-card bg-zinc-900 border border-white/10 rounded-[3rem] p-8 md:p-12 flex flex-col justify-between">
<div>
<span class="text-cyan-400 font-bold text-xs uppercase tracking-widest">SaaS Architecture</span>
<h3 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mt-4">CloudFlow</h3>
</div>
<div class="text-[10px] font-mono text-zinc-600 uppercase">Deployed // 2026</div>
</div>
<div class="project-card bg-zinc-900 border border-white/10 rounded-[3rem] p-8 md:p-12 flex flex-col justify-between">
<div>
<span class="text-cyan-400 font-bold text-xs uppercase tracking-widest">Web3 Gaming</span>
<h3 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mt-4">Neon Realms</h3>
</div>
<div class="text-[10px] font-mono text-zinc-600 uppercase">Deployed // 2026</div>
</div>
</div>
</div>
</div>
</section>

<!-- Services -->
<section id="services" class="max-w-7xl mx-auto px-6 py-32">
<h2 class="text-4xl font-black uppercase mb-16 tracking-tighter">Our <span class="text-cyan-400 italic">Expertise</span></h2>
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
<div class="p-12 bg-zinc-900/50 border border-white/10 rounded-[3rem] reveal">
<h3 class="text-3xl font-bold mb-4">UI/UX Architecture</h3>
<p class="text-zinc-400 mb-8">Data-driven design that prioritizes conversions and high retention rates.</p>
<button onclick="toggleModal(true)" class="text-cyan-400 font-black uppercase text-[10px] tracking-widest flex items-center gap-2">Initiate Brief <i data-lucide="chevron-right" class="w-4 h-4"></i></button>
</div>
<div class="p-12 bg-zinc-900/50 border border-white/10 rounded-[3rem] reveal">
<h3 class="text-3xl font-bold mb-4">Full Stack Systems</h3>
<p class="text-zinc-400 mb-8">End-to-end development of complex web applications and API integrations.</p>
<button onclick="toggleModal(true)" class="text-cyan-400 font-black uppercase text-[10px] tracking-widest flex items-center gap-2">Initiate Brief <i data-lucide="chevron-right" class="w-4 h-4"></i></button>
</div>
</div>
</section>

<!-- Footer -->
<footer class="py-20 border-t border-white/5 bg-black/50 text-center">
<span class="font-black text-xl italic uppercase">HRG<span class="text-cyan-400">_SOLUTIONS</span></span>
<div class="text-[10px] text-zinc-600 font-mono mt-4 uppercase tracking-[0.5em]">2026 // ALL SYSTEMS NOMINAL</div>
</footer>

<!-- Modal -->
<div id="modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-6">
<div class="absolute inset-0 bg-black/90 backdrop-blur-md" onclick="toggleModal(false)"></div>
<div class="relative w-full max-w-lg bg-zinc-900 border border-white/10 rounded-[3rem] p-10">
<h2 class="text-3xl font-black uppercase mb-6 italic">Launch <span class="text-cyan-400">Sequence</span></h2>
<form class="space-y-4">
<input type="text" placeholder="Name" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl focus:border-cyan-500 outline-none">
<input type="email" placeholder="Email" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl focus:border-cyan-500 outline-none">
<textarea placeholder="Brief Project Scope" class="w-full bg-white/5 border border-white/10 p-4 rounded-2xl h-32 focus:border-cyan-500 outline-none"></textarea>
<button type="submit" class="w-full bg-cyan-500 text-black py-4 rounded-2xl font-black uppercase tracking-widest">Send Brief</button>
</form>
</div>
</div>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>

<script>
// Init Icons
lucide.createIcons();

// Modal Control
function toggleModal(show) {
const m = document.getElementById('modal');
m.style.display = show ? 'flex' : 'none';
}

// Intersection Observer for simple reveals
const observer = new IntersectionObserver((entries) => {
entries.forEach(entry => {
if (entry.isIntersecting) entry.target.classList.add('active');
});
}, { threshold: 0.1 });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// GSAP Horizontal Scroll Logic
gsap.registerPlugin(ScrollTrigger);

const race = document.getElementById('horizontal-track');

// Calculate the distance to scroll (Width of container - viewport width)
function getScrollAmount() {
let raceWidth = race.scrollWidth;
return -(raceWidth - window.innerWidth);
}

// Desktop/Tablet Animation
if (window.innerWidth > 768) {
const tween = gsap.to(race, {
x: getScrollAmount,
duration: 3,
ease: "none"
});

ScrollTrigger.create({
trigger: ".horizontal-trigger",
start: "top top",
end: () => `+=${race.scrollWidth}`,
pin: true,
animation: tween,
scrub: 1, // High scrub value for smoothness
invalidateOnRefresh: true
});
} else {
// Mobile Optimization: Use native touch scroll for better performance
const track = document.getElementById('horizontal-track');
track.parentElement.style.overflowX = "auto";
track.parentElement.classList.add('no-scrollbar', 'snap-x');
// Remove the 300vh trigger height on mobile to prevent empty scrolling space
document.querySelector('.horizontal-trigger').style.height = "auto";
}
</script>
</body>
</html>
