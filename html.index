<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HRG Solutions | High-Impact Web Engineering</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/framer-motion@10.16.4/dist/framer-motion.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
<style>
body { font-family: 'Inter', sans-serif; background-color: #09090b; }
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
.snap-x { scroll-snap-type: x mandatory; }
.snap-center { scroll-snap-align: center; }

/* Grid Background */
.grid-bg {
background-image: radial-gradient(circle at center, #22d3ee 1px, transparent 1px);
background-size: 32px 32px;
}

/* Custom animation for the scroll section */
#horizontal-scroll-content {
display: flex;
gap: 3rem;
will-change: transform;
}
</style>
</head>
<body class="text-white selection:bg-cyan-500/30 overflow-x-hidden">

<!-- Grid Background Layer -->
<div class="fixed inset-0 z-0 opacity-10 grid-bg pointer-events-none"></div>

<!-- Navigation -->
<nav class="fixed top-0 w-full z-[90] p-6 md:p-8 flex justify-between items-center bg-zinc-950/50 backdrop-blur-md border-b border-white/5">
<div class="flex items-center gap-3">
<div class="w-10 h-10 bg-gradient-to-tr from-cyan-500 to-indigo-600 rounded-xl flex items-center justify-center shadow-[0_0_20px_rgba(34,211,238,0.3)]">
<i data-lucide="rocket" class="text-white w-6 h-6"></i>
</div>
<span class="font-black text-2xl tracking-tighter text-white italic uppercase">HRG<span class="text-cyan-400">_SOLUTIONS</span></span>
</div>
<div class="hidden lg:flex items-center gap-2 bg-white/5 border border-white/10 p-1.5 rounded-full">
<a href="#stack" class="px-6 py-2 text-[10px] uppercase tracking-[0.2em] text-zinc-400 hover:text-white hover:bg-white/5 rounded-full transition-all font-bold">Architecture</a>
<a href="#history" class="px-6 py-2 text-[10px] uppercase tracking-[0.2em] text-zinc-400 hover:text-white hover:bg-white/5 rounded-full transition-all font-bold">Portfolio</a>
<a href="#services" class="px-6 py-2 text-[10px] uppercase tracking-[0.2em] text-zinc-400 hover:text-white hover:bg-white/5 rounded-full transition-all font-bold">Services</a>
</div>
<button onclick="toggleModal()" class="hidden md:block bg-white text-black px-6 py-2.5 rounded-full text-[10px] font-black uppercase tracking-widest hover:bg-cyan-400 transition-all">Start Project</button>
</nav>

<main class="relative z-10">
<!-- Hero Section -->
<section class="min-h-screen flex items-center justify-center pt-20">
<div class="text-center px-6">
<div class="inline-flex items-center gap-3 bg-cyan-500/10 border border-cyan-500/20 px-4 py-2 rounded-full mb-8">
<i data-lucide="radio" class="w-3 h-3 text-cyan-400"></i>
<span class="text-[10px] font-bold text-cyan-400 uppercase tracking-[0.3em]">Next-Gen Web Engineering</span>
</div>
<h1 class="text-[clamp(3rem,10vw,8.5rem)] font-black tracking-tighter leading-[0.8] text-white uppercase mb-8">
Engineering <br> High <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500 italic">Impact.</span>
</h1>
<p class="max-w-xl mx-auto text-zinc-400 text-lg md:text-xl font-medium leading-relaxed mb-12">
HRG Solutions builds lightning-fast websites and custom web applications optimized for SEO, speed, and conversion authority.
</p>
<button onclick="toggleModal()" class="bg-cyan-500 text-black px-12 py-6 rounded-full font-black uppercase tracking-widest text-xs hover:scale-105 transition-all">
Launch Your Project
</button>
</div>
</section>

<!-- Our Stack -->
<section id="stack" class="max-w-7xl mx-auto px-6 py-32">
<div class="flex items-center gap-4 mb-4">
<div class="h-[1px] w-12 bg-cyan-500/50"></div>
<span class="text-[10px] font-mono text-cyan-400 uppercase tracking-[0.5em]">Technology_Philosophy</span>
</div>
<h2 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter leading-none mb-16">
Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500 italic font-medium">Stack</span>
</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
<div class="p-10 bg-zinc-900/40 border border-white/10 rounded-[2.5rem] group">
<i data-lucide="zap" class="text-cyan-400 mb-6 w-10 h-10"></i>
<h3 class="text-2xl font-bold mb-4">Edge Performance</h3>
<p class="text-zinc-500 text-sm leading-relaxed">Server-side rendering for sub-second load times and peak reliability.</p>
</div>
<div class="p-10 bg-zinc-900/40 border border-white/10 rounded-[2.5rem] group">
<i data-lucide="search" class="text-cyan-400 mb-6 w-10 h-10"></i>
<h3 class="text-2xl font-bold mb-4">SEO First</h3>
<p class="text-zinc-500 text-sm leading-relaxed">Built-in indexing optimization and semantic structure for organic growth.</p>
</div>
<div class="p-10 bg-zinc-900/40 border border-white/10 rounded-[2.5rem] group">
<i data-lucide="monitor-smartphone" class="text-cyan-400 mb-6 w-10 h-10"></i>
<h3 class="text-2xl font-bold mb-4">Responsive UX</h3>
<p class="text-zinc-500 text-sm leading-relaxed">Fluid experiences across every possible viewport and interaction type.</p>
</div>
</div>
</section>

<!-- Work History (Hybrid Scroll) -->
<section id="history" class="relative">
<div class="max-w-7xl mx-auto px-6 mb-16">
<div class="flex items-center gap-4 mb-4">
<div class="h-[1px] w-12 bg-cyan-500/50"></div>
<span class="text-[10px] font-mono text-cyan-400 uppercase tracking-[0.5em]">Recent_Launches</span>
</div>
<h2 class="text-5xl md:text-7xl font-black text-white uppercase tracking-tighter leading-none">
Work <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-indigo-500 italic font-medium">History</span>
</h2>
</div>

<!-- Desktop Horizontal Scroll Container -->
<div id="scroll-section" class="hidden md:block h-[300vh] relative">
<div class="sticky top-0 h-screen flex items-center overflow-hidden">
<div id="horizontal-scroll-content" class="px-24">
<!-- Project Cards -->
<div class="flex-shrink-0 w-[600px] h-[450px] bg-zinc-900 border border-white/10 rounded-[3rem] p-12 flex flex-col justify-between group">
<div>
<span class="text-cyan-400 font-black text-xs uppercase tracking-widest">Next.js + Tailwind</span>
<h3 class="text-5xl font-black uppercase tracking-tighter mt-6">FinTech App</h3>
</div>
<div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.4em]">DEPLOYED // 2026</div>
</div>
<div class="flex-shrink-0 w-[600px] h-[450px] bg-zinc-900 border border-white/10 rounded-[3rem] p-12 flex flex-col justify-between group">
<div>
<span class="text-cyan-400 font-black text-xs uppercase tracking-widest">Headless Shopify</span>
<h3 class="text-5xl font-black uppercase tracking-tighter mt-6">E-Com Giant</h3>
</div>
<div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.4em]">DEPLOYED // 2026</div>
</div>
<div class="flex-shrink-0 w-[600px] h-[450px] bg-zinc-900 border border-white/10 rounded-[3rem] p-12 flex flex-col justify-between group">
<div>
<span class="text-cyan-400 font-black text-xs uppercase tracking-widest">React Dashboards</span>
<h3 class="text-5xl font-black uppercase tracking-tighter mt-6">SaaS Portal</h3>
</div>
<div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.4em]">DEPLOYED // 2026</div>
</div>
<div class="flex-shrink-0 w-[600px] h-[450px] bg-zinc-900 border border-white/10 rounded-[3rem] p-12 flex flex-col justify-between group">
<div>
<span class="text-cyan-400 font-black text-xs uppercase tracking-widest">Three.js</span>
<h3 class="text-5xl font-black uppercase tracking-tighter mt-6">Luxury VR</h3>
</div>
<div class="text-[10px] font-mono text-zinc-600 uppercase tracking-[0.4em]">DEPLOYED // 2026</div>
</div>
</div>
</div>
</div>

<!-- Mobile Snap Carousel -->
<div class="md:hidden overflow-x-auto snap-x snap-mandatory flex gap-6 px-6 pb-20 no-scrollbar">
<div class="flex-shrink-0 w-[85vw] h-[400px] snap-center bg-zinc-900 border border-white/10 rounded-[2rem] p-8 flex flex-col justify-between">
<h3 class="text-3xl font-black uppercase">FinTech App</h3>
<span class="text-cyan-400 text-xs">NEXT.JS</span>
</div>
<div class="flex-shrink-0 w-[85vw] h-[400px] snap-center bg-zinc-900 border border-white/10 rounded-[2rem] p-8 flex flex-col justify-between">
<h3 class="text-3xl font-black uppercase">E-Com Giant</h3>
<span class="text-cyan-400 text-xs">SHOPIFY</span>
</div>
<div class="flex-shrink-0 w-[85vw] h-[400px] snap-center bg-zinc-900 border border-white/10 rounded-[2rem] p-8 flex flex-col justify-between">
<h3 class="text-3xl font-black uppercase">SaaS Portal</h3>
<span class="text-cyan-400 text-xs">REACT</span>
</div>
</div>
</section>

<!-- Services -->
<section id="services" class="max-w-7xl mx-auto px-6 py-32">
<h2 class="text-4xl font-black uppercase mb-16 tracking-tighter">Our <span class="text-cyan-400 italic">Expertise</span></h2>
<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
<div class="p-10 bg-zinc-900/50 border border-white/10 rounded-[3rem]">
<h3 class="text-3xl font-bold mb-4">UI/UX Architecture</h3>
<p class="text-zinc-400 leading-relaxed mb-6">Data-driven interface design that prioritizes user retention and conversions.</p>
<button onclick="toggleModal()" class="text-cyan-400 text-[10px] font-bold uppercase tracking-widest flex items-center gap-2">Request Brief <i data-lucide="arrow-right" class="w-3 h-3"></i></button>
</div>
<div class="p-10 bg-zinc-900/50 border border-white/10 rounded-[3rem]">
<h3 class="text-3xl font-bold mb-4">SEO Optimization</h3>
<p class="text-zinc-400 leading-relaxed mb-6">Technical SEO integrated from the start to dominate search engine rankings.</p>
<button onclick="toggleModal()" class="text-cyan-400 text-[10px] font-bold uppercase tracking-widest flex items-center gap-2">Request Brief <i data-lucide="arrow-right" class="w-3 h-3"></i></button>
</div>
</div>
</section>
</main>

<!-- Footer -->
<footer class="py-24 px-8 border-t border-white/5 bg-black/50 text-center">
<div class="font-black text-2xl tracking-tighter text-white italic uppercase mb-4">HRG<span class="text-cyan-400">_SOLUTIONS</span></div>
<p class="text-zinc-600 text-[10px] font-mono uppercase tracking-[0.4em]">Design // Develop // Optimize</p>
</footer>

<!-- Contact Modal -->
<div id="modal" class="fixed inset-0 z-[150] hidden items-center justify-center p-6">
<div class="absolute inset-0 bg-black/90 backdrop-blur-xl" onclick="toggleModal()"></div>
<div class="relative w-full max-w-lg bg-zinc-900 border border-white/10 rounded-[3rem] p-12 overflow-hidden shadow-2xl">
<div class="absolute top-0 left-0 w-full h-1 bg-cyan-500"></div>
<h2 class="text-3xl font-black uppercase mb-8">Start Your <span class="text-cyan-400">Project</span></h2>
<form id="contactForm" class="space-y-4">
<input type="text" placeholder="Full Name" required class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 outline-none focus:border-cyan-500">
<input type="email" placeholder="Email Address" required class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 outline-none focus:border-cyan-500">
<textarea placeholder="Tell us about your project" class="w-full bg-white/5 border border-white/10 rounded-2xl p-4 h-32 outline-none focus:border-cyan-500"></textarea>
<button type="submit" class="w-full bg-cyan-500 text-black py-5 rounded-2xl font-black uppercase tracking-widest text-xs">Send Request</button>
</form>
</div>
</div>

<script>
// Initialize Icons
lucide.createIcons();

// Modal Logic
function toggleModal() {
const modal = document.getElementById('modal');
modal.classList.toggle('hidden');
modal.classList.toggle('flex');
}

// Horizontal Scroll Animation Logic (Desktop)
window.addEventListener('scroll', () => {
const scrollSection = document.getElementById('scroll-section');
const content = document.getElementById('horizontal-scroll-content');

if (!scrollSection || !content) return;

const rect = scrollSection.getBoundingClientRect();
const scrollPercent = Math.min(Math.max(0, -rect.top / (rect.height - window.innerHeight)), 1);

// Adjust the -75% based on total width of cards
const translateX = scrollPercent * 75;
content.style.transform = `translateX(-${translateX}%)`;
});

// Form Submission
document.getElementById('contactForm').addEventListener('submit', (e) => {
e.preventDefault();
alert('Request Received. Our team will contact you shortly.');
toggleModal();
});
</script>
</body>
</html>
